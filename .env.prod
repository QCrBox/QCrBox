QCRBOX_DOCKER_REPO=ghcr.io/qcrbox
QCRBOX_DOCKER_TAG=latest
QCRBOXTOOLS_VERSION=0.0.5

QCRBOX_ROOT_DIR=/opt/qcrbox
QCRBOX_SUPERVISORD_CONF_DIR=${QCRBOX_ROOT_DIR}/supervisord_conf
QCRBOX_WINE_INSTALLATIONS_DIR="/opt/wine_installations"

QCRBOX_VOLUMES_ROOT_DIR=/mnt/qcrbox
QCRBOX_REGISTRY_DB_DIR=${QCRBOX_VOLUMES_ROOT_DIR}/qcrbox_registry_data/
QCRBOX_SHARED_FILES_DIR_CONTAINER_PATH=${QCRBOX_VOLUMES_ROOT_DIR}/shared_files/
QCRBOX_SHARED_FILES_DIR_HOST_PATH=./shared_files/

# By default, QCRBOX is only accessible on the same host, which makes
# local development more secure. In order to access QCRBOX remotely,
# the bind address should be set to "0.0.0.0".
#QCRBOX_BIND_ADDRESS="127.0.0.1"
QCRBOX_BIND_ADDRESS="0.0.0.0"

# List of allowed hosts for QCrBox web applications, comma separated.
# Should include subdomains for the reverse proxy.
# Defaults to .localhost, 127.0.0.1 and the bind address if not set here.
#QCRBOX_ALLOWED_HOSTS=".example.com,.qcrbox.example.com"

QCRBOX__REVERSE_PROXY__PORT=12345

# TLS certificates. For a PUBLICLY REACHABLE deployment with a real domain,
# set the resolver to "letsencrypt" and provide a contact email for Let's
# Encrypt. Leave the resolver empty (the default) to use Traefik's self-signed
# certificate or a supplied certificate (services/core/qcrbox_traefik/dynamic/)
# - required for LAN-only deployments, where ACME challenges cannot succeed.
QCRBOX_TLS_CERT_RESOLVER=
QCRBOX_ACME_EMAIL=

# NATS has no authentication and must never be exposed beyond this machine.
# Keep this bound to the loopback interface; it only serves local admin
# tooling (natscli, nats-top), e.g. through an SSH tunnel.
QCRBOX_NATS_BIND_ADDRESS=127.0.0.1

QCRBOX__NATS__HOST=localhost
QCRBOX__NATS__PORT=4222
QCRBOX__NATS__MANAGEMENT_PORT=8222
QCRBOX__NATS__STORE_DIR=.local_data/nats_store
# The registry API is published on the loopback interface only, for
# host-side tooling and SSH-based debugging. External access goes through
# Traefik + Authelia.
QCRBOX_REGISTRY_HOST=localhost
QCRBOX_REGISTRY_PORT=11000
# Code autoreload is a development feature; keep it off in deployments.
QCRBOX__REGISTRY__SERVER__ENABLE_AUTORELOAD=False

QCRBOX_SHELX_DOWNLOAD_USERNAME=CHANGEME-CHANGEME-CHANGEME
QCRBOX_SHELX_DOWNLOAD_PASSWORD=CHANGEME-CHANGEME-CHANGEME

# Domain configuration for the reverse proxy and Authelia.
# For production, set this to your actual domain (e.g., qcrbox.example.com).
# Services are served on subdomains: auth.<domain>, api.registry.<domain>,
# <app>.gui.<domain>, traefik.<domain>.
QCRBOX_DOMAIN=localhost.local

# Authelia Authentication Secrets
# IMPORTANT: Generate new secrets for production with:
#   JWT: openssl rand -hex 32
#   Session: openssl rand -hex 64
#   Encryption: openssl rand -hex 32
# DO NOT use these development secrets in production!
AUTHELIA_JWT_SECRET=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32
AUTHELIA_SESSION_SECRET=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-64
AUTHELIA_STORAGE_ENCRYPTION_KEY=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32

# LLDAP (user directory with web UI at https://users.<domain>)
# The admin password is also the Authelia login for the 'admin' user.
LLDAP_JWT_SECRET=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32
LLDAP_KEY_SEED=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32
LLDAP_ADMIN_PASSWORD=CHANGEME-SET-A-STRONG-PASSWORD

# On-demand container spawning (multi-user). When enabled, the registry
# spawns application containers via the docker socket proxy as needed.
QCRBOX__ORCHESTRATOR__ENABLED=false
#QCRBOX__ORCHESTRATOR__ENABLED=true

# Shared secret that authorises trusted services (e.g. the QCrBox web frontend)
# to act on behalf of a user via the X-QCrBox-User header.
# openssl rand -hex 32
QCRBOX_SERVICE_TOKEN=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32

# Injected by Traefik into requests it forwards to the registry; the registry
# only trusts the Remote-User header when this token accompanies it.
# openssl rand -hex 32
QCRBOX_GATEWAY_TOKEN=CHANGEME-GENERATE-NEW-SECRET-WITH-OPENSSL-RAND-HEX-32
