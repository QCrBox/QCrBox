<button 
    class="button is-light m-3" 
    onclick="closeCrystalExplorerTab()" 
    hx-post="/views/close_crystal_explorer_session" 
    hx-target="#end-workflow-step" 
    hx-swap="outerHTML">
    Stop Interactive Session
</button>

<div id="start-button" hx-swap-oob="outerHTML">
    <button 
        class="button is-dark m-3 is-loading" style="background-color: #417890;">
        Start Interactive Session
    </button>
</div>

<button id="run-command-triangle-button-2" hx-swap-oob="outerHTML" class="button is-ghost is-loading" style="transform: rotate(180deg);">
    <span class="icon">
        <i id="run-command-triangle-2" class="ph-fill ph-triangle" style="color: #8A8A8A; font-size: 3em;"></i>
    </span>
</button>