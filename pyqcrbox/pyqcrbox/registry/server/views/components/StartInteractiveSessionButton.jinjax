{# def application_slug, application_version, data_file_id #}
<button
    class="button is-dark m-3" style="background-color: #417890;"
    hx-post="/views/interactive/start_session?application_slug={{ application_slug }}&application_version={{ application_version }}&data_file_id={{ data_file_id }}"
    hx-target="#stop-button"
    hx-swap="innerHTML"
    onclick="openInteractiveSessionTab()">
    Start interactive session
</button>
