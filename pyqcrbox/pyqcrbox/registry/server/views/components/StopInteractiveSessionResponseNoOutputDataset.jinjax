<div id="data-step">
    <VerticalConnectorLine />
    <div style="display: inline-flex; align-items: center;">
	No output dataset.
    </div>
</div>

<button id="run-command-triangle-button" hx-swap-oob="outerHTML" class="button is-ghost" style="transform: rotate(180deg);">
    <span class="icon">
        <i id="run-command-triangle" class="ph-fill ph-triangle" style="color: #000000; font-size: 3em;"></i>
    </span>
</button>

<div id="metadata" hx-swap-oob="outerHTML">
    <h3 class="title is-4">Workflow Finished</h3>
    <p>No output dataset available.</p>
</div>

<div id="start-button" hx-swap-oob="outerHTML">
</div>

<div id="stop-button" hx-swap-oob="outerHTML">
</div>
