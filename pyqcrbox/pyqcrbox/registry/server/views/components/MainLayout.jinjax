{#def title #}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <script src="/static/htmx@2.0.3.min.js"></script>
  <script src="/static/htmx-ext-debug@2.0.0.js"></script>
  <script src="https://unpkg.com/htmx-ext-loading-states@2.0.0/loading-states.js"></script>
  <script src="https://unpkg.com/hyperscript.org@0.9.12"></script>
  <link rel="stylesheet" href="/static/icons/phosphor/fonts/regular/style.css">
  <link rel="stylesheet" href="/static/icons/phosphor/fonts/fill/style.css">
  <link rel="stylesheet" href="/static/bulma@1.0.2.min.css">
  <link rel="stylesheet" href="/static/custom.css">
  <style>
    .modal {
        display: none;
    }
  </style>
</head>

<body hx-ext="loading-states">
  <section class="section">
    <div class="container">
      <Header title={{ title }} />
    </div>
    <div class="container">
      {{ content }}
     <div>
  </section>
</body>
