{#def dataset_info, applications = [] #}

{% if dataset_info.contains_single_file %}
    <div id="datafile-text">{{ dataset_info.first_data_file.filename }}</div>
    <div id="metadata" hx-swap-oob="innerHTML">
        <h3 class="title is-4">Dataset Metadata</h3>
        <ul>
            <li>Dataset id: <code>{{ dataset_info.dataset_id }}</code></li>
            <li>File type: <code>{{ dataset_info.first_data_file.filetype }}</code></li>
        </ul>
    </div>
    <div id="dataset-id" hx-swap-oob="innerHTML">
        {{ dataset_info.dataset_id }}
    </div>

    <div id="run-command-step" hx-swap-oob="outerHTML">
        <RunCommandStep applications={{ applications }} />
    </div>

{% elif dataset_info.is_empty %}
    <div id="datafile-text">
        <i>Empty dataset<i>
    </div>
    <div id="metadata" hx-swap-oob="innerHTML">
        <div class="notification is-danger is-light">
            Error: the dataset contains no data files.
        </div>
    </div>

{% else %}
    <div id="datafile-text">
        <i>Multi-file dataset<i>
    </div>
    <div id="metadata" hx-swap-oob="innerHTML">
        <div class="notification is-danger is-light">
            Warning: the dataset contains multiple files, which is not currently supported.
        </div>
    </div>

{% endif %}



<script>
    function updateStartSessionButton() {
        const selectedOption = document.querySelector('#select-application-dropdown > option:checked')

        console.log("Updating start session button");
        console.log(`Selected option: ${selectedOption}`);
        const appName = selectedOption.getAttribute('data-name');
        const appSlug = selectedOption.getAttribute('data-slug');
        const appVersion = selectedOption.getAttribute('data-version');
        const url = `/views/view_start_session_button?data_file_id={{ dataset_info.first_data_file.qcrbox_file_id}}&application_name=${appName}&application_slug=${appSlug}&application_version=${appVersion}`;

        htmx.ajax('GET', url, '#start-button').then(() => {
            console.log("Successfully updated start session button");
        });
    }

    // Update metadata when a selection is made
    document.getElementById('select-application-dropdown').addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex]; // Get the selected option
        const metadataBox = document.getElementById('metadata');

        // Get the details from the application attributes
        const appName = selectedOption.getAttribute('data-name');
        const appUrl = selectedOption.getAttribute('data-url');
        const appVersion = selectedOption.getAttribute('data-version');
        const appRegistered = selectedOption.getAttribute('data-registered');
        
        // If a valid application is selected, construct the HTML content
        if (appName && appVersion && appRegistered) {
            metadataBox.outerHTML = `
            <div id="metadata">
                <h3 class="title is-4">${appName}</h3>
                <ul class="list" style="list-style-type: disc; padding-left: 20px;">
                    <li>Version: ${appVersion}</li>
                    <li>Date Registered: ${appRegistered}</li>
                    <li>Website: <a href="${appUrl}" target="_blank" class="has-text-link">
                            ${appName}
                        </a>
                    </li>
                </ul>
            </div>
            `;
        } 
    });
</script>
