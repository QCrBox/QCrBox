{#def title = "QCrBox" #}

<MainLayout title={{ title }}>
    <div class="columns mt-3">
        <div class="column">
            <InitialDataStepRow />
            <div id="run-command-step">
            </div>
            <div id="data-step">
            </div>
            <div id="run-command-step-2">
            </div>
            <div id="end-workflow-step">
            </div>
            
        </div>

        <div class="column">
            <div class="box mt-3" style="border: 2px solid #417890; padding: 10px;">
                <div id="metadata">
                    Information about the data file.
                </div>
                <div id="start-button">
                </div>
                <div id="stop-button">
                </div>
            </div>
        </div>
    </div>

    <div class="modal"
         id="modal"
         _="on showModal add .is-active on closeModal remove .is-active"
    >
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Import your data</p>
                <button class="delete"
                        aria-label="close"
                        id="close-modal"
                        _="on click trigger closeModal"
                ></button>
            </header>
            <section class="modal-card-body" id="modal-content">
                <DatasetUploadForm />
            </section>
            <footer class="modal-card-foot">
            </footer>
        </div>
    </div>

</MainLayout>

<script>
    let interactiveSessionTabs = {};  // Variable to store the reference to the opened tab(s)
    let gui_ports = {
        "olex2": 12004,
        "crystal_explorer": 12003,
        "dummy_gui": 12002,
    };
    let myAppSlug = "dummy_gui";

    function openInteractiveSessionTab(appSlug) {
        // Open the URL in a new tab and store the reference
        let hostname = window.location.hostname;
        let port = gui_ports[appSlug] || 12001;
        console.log(`Looking up GUI port for appSlug '${appSlug}' (found: ${port})`)
        interactiveSessionTabs[appSlug] = window.open(`http://${hostname}:${port}/vnc.html?path=vnc&autoconnect=true&resize=remote&reconnect=true&show_dot=true`, '_blank');
    }

    function closeInteractiveSessionTab(appSlug) {
        // Close the tab if it's open
        let session_tab = interactiveSessionTabs[appSlug];
        if (session_tab && !session_tab.closed) {
            session_tab.close();
            interactiveSessionTabs[appSlug] = null;
        }
    }

</script>
