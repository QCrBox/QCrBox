{# def applications = [] #}

<VerticalConnectorLine />
<div style="display: inline-flex; align-items: center;">
    <button id="run-command-triangle-button" class="button is-ghost" style="transform: rotate(180deg);">
        <span class="icon">
            <i id="run-command-triangle" class="ph-fill ph-triangle" style="color: #8A8A8A; font-size: 3em;"></i>
        </span>
    </button>
    <HorizontalConnectorLine />
    <div class="box" style="border: 2px solid #417890; padding: 10px;">
        <select
            id="select-application"
            name="application"
            onchange="updateStartSessionButton()"
        >
            <option value="" disabled selected hidden>Please select an application</option>
            {% if applications %}
                {% for application in applications %}
                    <option value="{{application.name}}"
                            data-name="{{ application.name }}"
                            data-slug="{{ application.slug }}"
                            data-version="{{ application.version }}"
                            data-url="{{ application.url }}"
                            data-registered="{{ application.registered_at.strftime('%Y-%m-%d %H:%M:%S') }}">
                        {{ application.name }}
                    </option>
                {% endfor %}
            {% else %}
                <option value="no_applications">No applications registered.</option>
            {% endif %}
        </select>
    </div>
</div>
