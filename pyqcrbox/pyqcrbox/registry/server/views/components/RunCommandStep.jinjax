{# def applications = [] #}

<VerticalConnectorLine />
<div style="display: inline-flex; align-items: center;">
    <button id="run-command-triangle-button" class="button is-ghost" style="transform: rotate(180deg);">
        <span class="icon">
            <i id="run-command-triangle" class="ph-fill ph-triangle" style="color: #8A8A8A; font-size: 2.5em;"></i>
        </span>
    </button>
    <HorizontalConnectorLine />
    <div id="application-box" class="box" style="border: 2px solid #417890; padding: 10px;">
        <SelectApplicationDropdown applications={{ applications }} />
    </div>
</div>
